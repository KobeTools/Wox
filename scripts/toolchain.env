# Pinned toolchains for scripts/build-install-local.sh (KobeTools fork).
# Bump these deliberately, alongside an upstream sync, and note it in FORK.md.

# Go: GOTOOLCHAIN pins this exact release; Go downloads and verifies it
# against sum.golang.org if the local Go is older.
GO_VERSION=1.26.5

# Node major version the plugin host is built with (pnpm itself is pinned by
# "packageManager" in package.json and verified against the lockfile).
NODE_MAJOR=24
PNPM_VERSION=12.6.0

# uv and the Python used for the Python plugin host.
UV_VERSION=0.11.5
PYTHON_VERSION=3.11

# The one prebuilt binary upstream commits: Microsoft's WebView2 loader
# (1.0.1210.39, x64, Authenticode-signed by Microsoft).
WEBVIEW2_LOADER_SHA256=f0fccd520afd3056df3130b6ccd3386fef029fe8a5637f190b1da57c96330e85
